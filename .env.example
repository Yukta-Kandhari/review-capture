# Email on Render free tier (recommended — HTTPS, no blocked SMTP ports)
SENDGRID_API_KEY=SG.your-api-key
EMAIL_FROM="Your Name <your-verified-sender@example.com>"
PM_EMAIL=your@gmail.com

# Optional SMTP fallback (local development or paid hosting)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password

# App URL for sign links in client emails
# On Render: auto-set via RENDER_EXTERNAL_URL — do NOT set PUBLIC_BASE_URL to localhost
# From local dev sending real emails: set APP_URL to your Render URL
# APP_URL=https://review-capture-xxxx.onrender.com
HTTP_PORT=3000

# Anthropic — review generation
ANTHROPIC_API_KEY=sk-ant-your-key
CLAUDE_MODEL=claude-sonnet-4-20250514

# Google Form for unhappy-path feedback
GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/YOUR_FORM_ID/viewform
